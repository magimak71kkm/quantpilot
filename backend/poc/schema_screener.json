{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["market","cap_tier","filters","sort","limit","confidence","explain"],
  "properties": {
    "market": {"enum": ["KOSPI","KOSDAQ","US_NYSE","US_NASDAQ"]},
    "cap_tier": {"enum": ["large","mid","small","any"]},
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field","op","value"],
        "properties": {
          "field": {"enum": ["PER","PBR","ROE","dividend","marketCap","price","volume","changePct","changePct_5d","changePct_20d","RSI","sector"]},
          "op":    {"enum": ["==","!=","<","<=",">",">=","in","between"]},
          "value": {}
        }
      }
    },
    "sort": {
      "type": "object",
      "required": ["field","dir"],
      "properties": {
        "field": {"type": "string"},
        "dir":   {"enum": ["asc","desc"]}
      }
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 200},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "explain": {"type": "string", "minLength": 1}
  }
}
