# Copy to deploy/.env and fill values.
# All variables use QP_ prefix (Pydantic Settings).

QP_ENV=dev
QP_FRONTEND_ORIGIN=http://localhost:5173

# JWT signing secret (32+ bytes recommended)
QP_JWT_SECRET=change-me-in-prod

# KMS key for AES-GCM refresh_token encryption (base64 of 32 raw bytes)
# Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
QP_KMS_KEY_B64=

# Google Cloud OAuth (see docs/google_oauth_setup.md)
QP_GOOGLE_CLIENT_ID=
QP_GOOGLE_CLIENT_SECRET=
QP_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
QP_GOOGLE_SCOPES=openid email https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/script.projects

# Gemini
QP_GEMINI_API_KEY=
QP_GEMINI_MODEL=gemini-1.5-flash
QP_GEMINI_DAILY_QUOTA_PER_USER=100
