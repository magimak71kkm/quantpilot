{
  "title": "QuantPilot · Rate & Traffic",
  "uid": "qp-rate",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"type": "timeseries", "title": "Requests per second by path",
     "gridPos": {"h": 10, "w": 24, "x": 0, "y": 0},
     "targets": [
       {"expr": "sum by (path_template) (rate(qp_http_requests_total[1m]))",
        "legendFormat": "{{path_template}}", "refId": "A"}
     ],
     "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"type": "timeseries", "title": "AI calls per second (ok vs schema_fail)",
     "gridPos": {"h": 9, "w": 24, "x": 0, "y": 10},
     "targets": [
       {"expr": "sum by (kind, outcome) (rate(qp_ai_calls_total[1m]))",
        "legendFormat": "{{kind}} / {{outcome}}", "refId": "A"}
     ],
     "fieldConfig": {"defaults": {"unit": "reqps"}}},
    {"type": "stat", "title": "Total 24h requests",
     "gridPos": {"h": 5, "w": 6, "x": 0, "y": 19},
     "targets": [{"expr": "sum(increase(qp_http_requests_total[24h]))", "refId": "A"}]}
  ]
}
