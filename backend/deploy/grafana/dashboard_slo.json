{
  "title": "QuantPilot · SLO (30d)",
  "uid": "qp-slo",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-30d", "to": "now"},
  "panels": [
    {"type": "stat", "title": "Availability (30d)",
     "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
     "targets": [
       {"expr": "100 * (1 - sum(increase(qp_http_requests_total{status=~\"5..\"}[30d])) / sum(increase(qp_http_requests_total[30d])))",
        "refId": "A"}
     ],
     "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [
       {"color": "red", "value": null}, {"color": "orange", "value": 99}, {"color": "green", "value": 99.9}
     ]}}}},
    {"type": "stat", "title": "Latency SLO p95 ≤ 2s",
     "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
     "targets": [
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(qp_http_request_duration_seconds_bucket[30d])))",
        "refId": "A"}
     ],
     "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [
       {"color": "green", "value": null}, {"color": "orange", "value": 2}, {"color": "red", "value": 4}
     ]}}}},
    {"type": "stat", "title": "AI schema-fail rate (30d)",
     "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
     "targets": [
       {"expr": "100 * sum(increase(qp_ai_calls_total{outcome=\"schema_fail\"}[30d])) / sum(increase(qp_ai_calls_total[30d]))",
        "refId": "A"}
     ],
     "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [
       {"color": "green", "value": null}, {"color": "orange", "value": 5}, {"color": "red", "value": 10}
     ]}}}},
    {"type": "timeseries", "title": "Error budget burn rate (1h vs 6h)",
     "gridPos": {"h": 9, "w": 24, "x": 0, "y": 6},
     "targets": [
       {"expr": "sum(rate(qp_http_requests_total{status=~\"5..\"}[1h])) / sum(rate(qp_http_requests_total[1h])) / 0.001",
        "legendFormat": "burn 1h (target 0.1%)", "refId": "A"},
       {"expr": "sum(rate(qp_http_requests_total{status=~\"5..\"}[6h])) / sum(rate(qp_http_requests_total[6h])) / 0.001",
        "legendFormat": "burn 6h (target 0.1%)", "refId": "B"}
     ]}
  ]
}
