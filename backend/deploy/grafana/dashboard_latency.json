{
  "title": "QuantPilot · Latency",
  "uid": "qp-latency",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "path", "type": "query", "datasource": {"type": "prometheus"},
     "query": "label_values(qp_http_request_duration_seconds_bucket, path_template)",
     "refresh": 2, "includeAll": true, "multi": true}
  ]},
  "panels": [
    {"type": "timeseries", "title": "p50 / p95 / p99 latency (all endpoints)",
     "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
     "targets": [
       {"expr": "histogram_quantile(0.50, sum by (le) (rate(qp_http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(qp_http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "p95", "refId": "B"},
       {"expr": "histogram_quantile(0.99, sum by (le) (rate(qp_http_request_duration_seconds_bucket[5m])))",
        "legendFormat": "p99", "refId": "C"}
     ],
     "fieldConfig": {"defaults": {"unit": "s"}}},
    {"type": "timeseries", "title": "p95 latency per endpoint",
     "gridPos": {"h": 9, "w": 24, "x": 0, "y": 9},
     "targets": [
       {"expr": "histogram_quantile(0.95, sum by (le, path_template) (rate(qp_http_request_duration_seconds_bucket{path_template=~\"$path\"}[5m])))",
        "legendFormat": "{{path_template}}", "refId": "A"}
     ],
     "fieldConfig": {"defaults": {"unit": "s"}}},
    {"type": "stat", "title": "In-flight requests",
     "gridPos": {"h": 5, "w": 6, "x": 0, "y": 18},
     "targets": [{"expr": "qp_http_in_flight", "refId": "A"}]}
  ]
}
