# QuantPilot Backend 환경변수 템플릿 — 복사 후 실제 값 입력 (git 커밋 금지)
# 사용법: cp .env.example .env  (backend/ 또는 deploy/ 에서)

QP_ENV=dev
QP_FRONTEND_ORIGIN=https://<YOUR_ID>.github.io/<REPO>/

# DB — 로컬 SQLite 또는 PostgreSQL
QP_DATABASE_URL=sqlite:///./quantpilot.db
# QP_DATABASE_URL=postgresql+psycopg2://quantpilot:quantpilot@localhost:5432/quantpilot
QP_REDIS_URL=redis://localhost:6379/0

# JWT (운영 배포 시 반드시 긴 랜덤 값으로 교체)
QP_JWT_SECRET=change-me-to-long-random-string
QP_JWT_ALG=HS256
QP_JWT_TTL_MIN=30

# KMS 스텁 (운영: Vault/Cloud KMS 사용)
QP_KMS_KEY_B64=

# Google OAuth (GCP 콘솔에서 발급)
QP_GOOGLE_CLIENT_ID=
QP_GOOGLE_CLIENT_SECRET=
QP_GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# Gemini AI
QP_GEMINI_API_KEY=
QP_GEMINI_MODEL=gemini-1.5-flash
QP_GEMINI_DAILY_QUOTA_PER_USER=100

# Rate limit (Redis 토큰 버킷)
QP_RATE_PER_USER_PER_MIN=60
QP_RATE_PER_IP_PER_MIN=600

# OpenTelemetry (선택)
QP_OTEL_ENABLED=false
QP_OTEL_ENDPOINT=http://otel-collector:4317

# Slack 알림 (선택)
QP_SLACK_WEBHOOK_URL=

# 관리자 (운영 환경에서 감사로그 API 허용 사용자 ID)
QP_ADMIN_USER_IDS=
